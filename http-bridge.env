# FileEngine HTTP Bridge configuration.
# Loaded by the systemd unit via EnvironmentFile=. Format: KEY=VALUE (no quotes,
# no inline comments). Edit and `systemctl restart fileengine-http-bridge`.

# --- HTTP listener ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8090
# Dedicated, correctly-sized worker pool (concurrent long-lived transfers).
HTTP_THREAD_POOL=16
# Dedicated reporter listener for /healthz /readyz /poolz (one worker held back).
HTTP_MONITORING_PORT=8091
HTTP_MAX_BODY_BYTES=104857600
# Scoped CORS origin for browser clients (empty = CORS disabled). Never use *.
# Legacy single origin; folded into the allow-list below for back-compat.
HTTP_CORS_ORIGIN=
# Multi-origin CORS allow-list (comma-separated, exact match, never *). Use this when
# a bespoke deployment embeds FileEngine in more than one host origin. The request's
# Origin is echoed back only on an exact match.
# e.g. HTTP_CORS_ORIGINS=https://app.customer.com,https://portal.customer.com
HTTP_CORS_ORIGINS=
# Trusted reverse-proxy IPs/CIDRs (comma-separated). PRODUCTION HARDENING: set
# this to the nginx / load-balancer address(es) so the real client IP is taken
# from X-Forwarded-For only via a trusted proxy (right-most untrusted hop). This
# prevents a client from spoofing its address (which would forge the MFA
# challenge-token IP binding and audit source_addr). Empty = development mode
# (the first X-Forwarded-For hop is trusted). Example: 127.0.0.1,10.0.0.0/8
FILEENGINE_TRUSTED_PROXIES=

# --- FileEngine gRPC core ---
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# --- LDAP authentication ---
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:389
FILEENGINE_LDAP_DOMAIN=dc=example,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# REQUIRED: set the bind-account password (kept out of the package on purpose).
FILEENGINE_LDAP_BIND_PASSWORD=
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=example,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=example,dc=com

# --- Bearer tokens ---
TOKEN_TTL_SECONDS=3600

# --- OAuth2 (optional; leave OAUTH_PROVIDERS empty to disable) ---
# Comma-separated provider ids; each needs OAUTH_<ID>_* settings (see DEVELOPER.md / OAUTH_SETUP.md).
OAUTH_PROVIDERS=
OAUTH_REDIRECT_BASE=
OAUTH_RETURN_ALLOWLIST=
OAUTH_STATE_TTL_SECONDS=300

# --- Commercial-integration token exchange (RFC 7523; §14.2) ---
# One integration per deployment. FileEngine imports ONLY the integration's PUBLIC
# key; leave INTEGRATION_ISSUER or the key empty to disable POST /v1/auth/exchange.
INTEGRATION_ISSUER=
# Expected assertion audience; defaults to OAUTH_REDIRECT_BASE + /v1/auth/exchange.
INTEGRATION_AUDIENCE=
# RS256/ES256 public key. Provide inline (PEM, may span lines is NOT supported in an
# EnvironmentFile — prefer the _FILE form) or via a readable file path.
INTEGRATION_PUBLIC_KEY=
INTEGRATION_PUBLIC_KEY_FILE=
# Optional client-IP allow-list (comma-separated IPs/CIDRs; empty = disabled). A
# matched exchange stamps the caller IP into the minted token's `aip` claim.
INTEGRATION_ALLOWED_IPS=
# Non-delegated service tokens (token_type:service): the integration acts as itself.
# Roles come from config below (NOT LDAP). Disabled by default.
INTEGRATION_ALLOW_SERVICE=false
INTEGRATION_SERVICE_ROLES=

# --- Logging ---
LOG_LEVEL=info
LOG_WRITE_TO_CONSOLE=true
